ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
CREATE_ADMIN_USER=true
USE_REDIS=false
DB_LOCATION=/app/config/sql_app.db
SECRET_KEY_FILE=/app/config/secret_key.txt
SIGNING_KEY_FILE=/app/config/sign_key.txt
VERIFY_KEY_FILE=/app/config/verify_key.txt
