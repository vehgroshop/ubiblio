ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
CREATE_ADMIN_USER=true
USE_REDIS=false
DB_LOCATION=./data/config/sql_app.db
SECRET_KEY_FILE=./data/config/secret_key.txt
SIGNING_KEY_FILE=./data/config/sign_key.txt
VERIFY_KEY_FILE=./data/config/verify_key.txt
# Optional: set to a fixed secret instead of using SECRET_KEY_FILE
# SECRET_KEY=
# Optional Google Books API key for richer ISBN metadata
# GB_API=
# Optional contact email sent to easycbapi.nl in every request header
# (required by the API for non-incidental use; defaults to joost.betten@gmail.com)
# EASYCB_CONTACT=
# Optional language override, e.g. FR
# LANGUAGE=
# Set DEV=true only for live-reload development
DEV=false
